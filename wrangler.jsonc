// Cloudflare Workers (static assets) configuration — the site is pure
// static files served from dist/, there is no Worker script.
{
  "name": "portfolio",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./dist",
    // Serve our custom 404 page for unknown URLs.
    "not_found_handling": "404-page",
  },
  // Required by `npx wrangler preview` (per-PR preview deployments).
  "previews": {},
}
