# HTTP headers served by Cloudflare (Workers static assets).
# Combination rule: a request matching several URL patterns inherits ALL
# their headers, same-named values being joined — two CSPs would enforce
# their intersection and break the demos. Hence the "! Header" detach
# syntax below: rules apply in file order, "!" removes what earlier
# rules added. Checked by scripts/check-headers.mjs at every build.

# ---- Whole site: strict defaults ----
# The portfolio ships ZERO client JavaScript, so script-src is 'none';
# re-open it deliberately (with a decision log entry) if that ever changes.
/*
  Content-Security-Policy: default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; worker-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), web-share=(), xr-spatial-tracking=()

# ---- Demos: looser inside, just as closed toward the outside ----
# Demo code may need inline scripts/styles or wasm, but still cannot
# reach any other origin ('self' everywhere, form-action 'none') and
# cannot register a service worker (worker-src 'none' — the demo rules
# forbid them; relax per-demo only with a decision log entry).
# NOTE: the Permissions-Policy inherited from /* refuses everything,
# fullscreen included — a future game needing it must detach and reset
# that header here, the same way CSP is.
/demos/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; worker-src 'none'; upgrade-insecure-requests

# ---- Caching: hashed assets are immutable, HTML keeps the default
# (max-age=0, must-revalidate + ETag) ----
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
