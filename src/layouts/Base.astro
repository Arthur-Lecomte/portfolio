---
/**
 * Shared shell of every portfolio page: head metadata (canonical,
 * hreflang, Open Graph), header with navigation and language switcher,
 * footer with contact and legal links. Zero client-side JavaScript.
 */
import { site } from '../data/site';
import { t, altLocale, localizePath, switchPath, type Locale } from '../i18n/ui';
import '../styles/global.css';
import inter400 from '../assets/fonts/inter/inter-latin-400.woff2?url';
import inter700 from '../assets/fonts/inter/inter-latin-700.woff2?url';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /**
   * Path of this page in the other language. Defaults to the same route
   * under the other prefix; null = no equivalent (hides the language
   * switcher and the hreflang pair — e.g. the shared 404 page).
   */
  altPath?: string | null;
}

const { locale, title, description, altPath } = Astro.props;
const strings = t(locale);
const other = altLocale(locale);

const path = Astro.url.pathname;
const otherPath = altPath === undefined ? switchPath(path, other) : altPath;
const frUrl = new URL(locale === 'fr' ? path : (otherPath ?? path), Astro.site);
const enUrl = new URL(locale === 'en' ? path : (otherPath ?? path), Astro.site);
const canonical = new URL(path, Astro.site);

const cvHref = locale === 'en' ? (site.cv.en ?? site.cv.fr) : site.cv.fr;
const cvNote = locale === 'en' && !site.cv.en && site.cv.fr ? ` ${strings.cvFrenchOnly}` : '';

const isCurrent = (prefix: string): 'page' | undefined =>
  path.startsWith(localizePath(locale, prefix)) ? 'page' : undefined;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {otherPath !== null && (
      <>
        <link rel="alternate" hreflang="fr" href={frUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={frUrl} />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.role[locale]}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter700} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {strings.skipLink}
    </a>

    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href={localizePath(locale, '/')}>
          {site.name}
        </a>
        <nav aria-label={strings.navLabel}>
          <ul class="site-nav">
            <li>
              <a href={localizePath(locale, '/projets/')} aria-current={isCurrent('/projets/')}>
                {strings.navProjects}
              </a>
            </li>
            <li>
              <a href={localizePath(locale, '/a-propos/')} aria-current={isCurrent('/a-propos/')}>
                {strings.navAbout}
              </a>
            </li>
            {cvHref && (
              <li>
                <a href={cvHref}>
                  {strings.navCv}
                  {cvNote}
                </a>
              </li>
            )}
            {otherPath !== null && (
              <li>
                <a class="lang-switch" href={otherPath} lang={other} hreflang={other}>
                  <span aria-hidden="true">{other.toUpperCase()}</span>
                  <span class="sr-only">{strings.langSwitch}</span>
                </a>
              </li>
            )}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <ul class="footer-links">
          <li>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <a href={site.links.linkedin} rel="noopener noreferrer">
              LinkedIn
            </a>
          </li>
          {site.links.github && (
            <li>
              <a href={site.links.github} rel="noopener noreferrer">
                GitHub
              </a>
            </li>
          )}
        </ul>
        <ul class="footer-links">
          <li>
            <a href={localizePath(locale, '/mentions-legales/')}>{strings.footerLegal}</a>
          </li>
          <li>
            <a href={localizePath(locale, '/confidentialite/')}>{strings.footerPrivacy}</a>
          </li>
        </ul>
        <p class="colophon">
          © {year} {site.name} — {strings.footerColophon}{' '}
          <a href={site.links.repo} rel="noopener noreferrer">
            {strings.footerSource}
          </a>
          .
        </p>
      </div>
    </footer>
  </body>
</html>
