---
import Base from '../layouts/Base.astro';
import HomePage from '../components/HomePage.astro';
import { site } from '../data/site';

const description =
  `${site.name}, ${site.role.fr} — ${site.location.fr}.` +
  (site.availability === 'open' ? ` ${site.availabilityText.fr}` : '');
---

<Base locale="fr" title={`${site.name} — ${site.role.fr}`} description={description}>
  <HomePage locale="fr" />
</Base>
