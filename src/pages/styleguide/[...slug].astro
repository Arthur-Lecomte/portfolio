---
/**
 * Token reference for the chosen direction (B — « Moderne neutre »).
 * Dev-only: getStaticPaths returns no path in production builds, so
 * this page exists neither on the live site nor in host previews.
 */
import { Font } from 'astro:assets';
import { site } from '../../data/site';
import '../../styles/global.css';
import '../../styles/styleguide.css';

export function getStaticPaths() {
  if (import.meta.env.PROD) return [];
  return [{ params: { slug: undefined } }];
}
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <Font cssVariable="--font-inter" preload />
    <title>Styleguide — {site.name}</title>
  </head>
  <body>
    <div class="sg-intro">
      <h1>Styleguide — direction B figée</h1>
      <p>
        Référence des tokens retenus (« Moderne neutre » : Inter partout, accent bleu encre). Page
        de travail, visible uniquement en local. Les tokens vivent dans
        <code>src/styles/tokens.css</code>.
      </p>
    </div>

    <section class="sg-section">
      <h2 class="block-title">Typographie</h2>
      <div class="scale-row">
        <code>--text-3xl</code>
        <span style="font-size: var(--text-3xl); font-weight: 700">{site.name}</span>
      </div>
      <div class="scale-row">
        <code>--text-2xl</code>
        <span style="font-size: var(--text-2xl); font-weight: 700">Titre de page</span>
      </div>
      <div class="scale-row">
        <code>--text-xl</code>
        <span style="font-size: var(--text-xl); font-weight: 600">Titre de section</span>
      </div>
      <div class="scale-row">
        <code>--text-lg</code>
        <span style="font-size: var(--text-lg); font-weight: 600">Titre de carte</span>
      </div>
      <div class="scale-row">
        <code>--text-base</code>
        <span>Texte courant, interligne 1,65, mesure 65ch.</span>
      </div>
      <div class="scale-row">
        <code>--text-sm</code>
        <span class="specimen-meta">Texte secondaire — dates, légendes, métadonnées</span>
      </div>
    </section>

    <section class="sg-section">
      <h2 class="block-title">Couleurs</h2>
      <div class="palettes">
        <div class="palette mode-light">
          <h3>Mode clair</h3>
          <span class="chip">
            <i style="background: #ffffff"></i> Fond #ffffff
          </span>
          <span class="chip">
            <i style="background: #16181d"></i> Texte #16181d
          </span>
          <span class="chip">
            <i style="background: #565b64"></i> Secondaire #565b64
          </span>
          <span class="chip">
            <i style="background: #f4f5f7"></i> Surface #f4f5f7
          </span>
          <span class="chip">
            <i style="background: #e4e6ea"></i> Bordure #e4e6ea
          </span>
          <span class="chip">
            <i style="background: #1f4fd8"></i> Accent #1f4fd8
          </span>
        </div>
        <div class="palette mode-dark">
          <h3>Mode sombre</h3>
          <span class="chip">
            <i style="background: #101216"></i> Fond #101216
          </span>
          <span class="chip">
            <i style="background: #e8eaee"></i> Texte #e8eaee
          </span>
          <span class="chip">
            <i style="background: #9aa0ab"></i> Secondaire #9aa0ab
          </span>
          <span class="chip">
            <i style="background: #181b21"></i> Surface #181b21
          </span>
          <span class="chip">
            <i style="background: #2a2e36"></i> Bordure #2a2e36
          </span>
          <span class="chip">
            <i style="background: #8ab0ff"></i> Accent #8ab0ff
          </span>
        </div>
      </div>
    </section>

    <section class="sg-section">
      <h2 class="block-title">En-tête du site</h2>
      <div class="mock-header">
        <span class="mock-brand">{site.name}</span>
        <nav class="mock-nav">
          <a href="#top">Projets</a>
          <a href="#top">À propos</a>
          <a href="#top">CV</a>
          <span class="lang">EN</span>
        </nav>
      </div>
    </section>

    <section class="sg-section">
      <h2 class="block-title">Carte projet</h2>
      <article class="mock-card">
        <div class="mock-cover">image de couverture</div>
        <div class="mock-card-body">
          <h3>Titre du projet</h3>
          <p>Une phrase sans jargon qui dit ce que fait le projet.</p>
          <span class="specimen-meta">2026 · C# · Unity</span>
        </div>
      </article>
    </section>

    <section class="sg-section">
      <h2 class="block-title">Accueil, sans aucun projet publié</h2>
      <div class="mock-hero">
        <h1>{site.name}</h1>
        <p class="hero-role">
          {site.role.fr} — {site.location.fr}
        </p>
        <p>
          Formé en C# et Java, je développe des applications métier. Ce site rassemble mes projets
          personnels.
        </p>
        <p class="hero-avail">{site.availabilityText.fr}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#top">
            Télécharger le CV
          </a>
          <a class="btn btn-secondary" href="#top">
            M’écrire
          </a>
        </div>
      </div>
    </section>

    <section class="sg-section">
      <h2 class="block-title">Page projets, état vide</h2>
      <p class="empty-state">Aucun projet publié pour le moment.</p>
    </section>
  </body>
</html>
