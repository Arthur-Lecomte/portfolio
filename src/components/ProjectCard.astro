---
/**
 * Card shown on the home page and the projects list. Text comes from
 * the right language file; shared data (date, stack, cover) from fr.md.
 */
import { Image } from 'astro:assets';
import { formatDate, t, localizePath, type Locale } from '../i18n/ui';
import { projectSlug, type Project, type ProjectEn } from '../lib/projects';

interface Props {
  locale: Locale;
  project: Project;
  /** English text entry — required when locale is 'en'. */
  english?: ProjectEn;
}

const { locale, project, english } = Astro.props;
const strings = t(locale);
const text = locale === 'en' && english ? english.data : project.data;
const slug = projectSlug(project);
const href = localizePath(locale, `/projets/${slug}/`);
---

<article class="card">
  <a href={href} class="card-link">
    <Image
      src={project.data.cover}
      alt={text.coverAlt}
      widths={[400, 800]}
      sizes="(max-width: 48rem) 100vw, 24rem"
      loading="lazy"
    />
    <div class="card-body">
      <h3>{text.title}</h3>
      <p>{text.summary}</p>
      <p class="meta">
        {formatDate(locale, project.data.date)} · {project.data.stack.join(' · ')}
        {project.data.draft && <mark class="draft-badge">{strings.draftBadge}</mark>}
      </p>
    </div>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface);
  }

  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
    height: 100%;
  }

  .card img {
    aspect-ratio: 16 / 9;
    object-fit: cover;
    width: 100%;
    border-bottom: 1px solid var(--color-border);
  }

  .card-body {
    padding: var(--space-md);
  }

  .card-body h3 {
    margin-bottom: var(--space-2xs);
  }

  .card-link:hover h3 {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .card-body p {
    margin: 0 0 var(--space-xs);
    font-size: var(--text-sm);
  }

  .draft-badge {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-radius: 3px;
    padding: 0 0.3rem;
    margin-left: 0.3rem;
  }
</style>
